# Copy this file to .env and fill in your real values.
# Get these from your Kite Connect developer app at developers.kite.trade
# Do NOT commit the real .env file anywhere.

KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# KITE_ACCESS_TOKEN is generated fresh each day — run `python get_token.py`
# to open the Kite login page and auto-save today's token here.
KITE_ACCESS_TOKEN=
