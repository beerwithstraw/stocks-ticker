# Copy this file to .streamlit/secrets.toml and fill in real values.
# On Streamlit Community Cloud, add these via the app's Settings → Secrets UI instead.
# NEVER commit secrets.toml to git.

KITE_API_KEY      = "your_api_key_here"
KITE_API_SECRET   = "your_api_secret_here"
KITE_ACCESS_TOKEN = ""   # leave blank — renew daily via the 🔑 Token button in the app
